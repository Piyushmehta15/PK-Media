# ============================================================
# PK Media — .gitignore
# NEVER commit secrets, local env files, build output, or dep caches.
# ============================================================

# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
*.local

# Environment & secrets — never commit real .env files
.env
.env.*
!.env.example
.env.local
.env.development
.env.test
.env.production

# Vite / editor caches
.vite/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# TypeScript build info
*.tsbuildinfo

# OS / editor
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo

# Test / coverage
coverage/
.nyc_output/

# Misc credential-ish patterns (defense in depth)
*.pem
*.key
*.p12
secrets/
credentials/
