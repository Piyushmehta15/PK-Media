# ============================================================
# PK MEDIA OS — Environment configuration
# Copy this file to .env.local and fill in real values to enable
# Supabase. Without these, the app runs in MOCK mode (fully
# functional, demo data).
#
#   cp .env.example .env.local
#
# NEVER put the service_role key here. It must only ever exist on
# your server / Supabase dashboard. The frontend only sees the public
# anon key.
# ============================================================

# --- Supabase (optional) ---
# Project URL, e.g. https://your-project.supabase.co
VITE_SUPABASE_URL=

# Project "anon" public key (safe for the browser). NOT service_role.
VITE_SUPABASE_ANON_KEY=

# --- Public website contact (optional overrides) ---
# VITE_WHATSAPP_NUMBER=917065969643
# VITE_WHATSAPP_MESSAGE=Hi PK Media, I'm interested in discussing a growth campaign for my brand.
